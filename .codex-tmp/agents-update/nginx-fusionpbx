server {
	listen [::]:443 ssl;
	listen 443 ssl;
	#listen 443 ssl http2;
	server_name fusionpbx pbx.mphone.vn;

	ssl_certificate         /etc/letsencrypt/live/pbx.mphone.vn/fullchain.pem;
	ssl_certificate_key     /etc/letsencrypt/live/pbx.mphone.vn/privkey.pem;
	#ssl_protocols           TLSv1.2 TLSv1.3;
	ssl_protocols	        TLSv1.2 TLSv1.3;
	ssl_prefer_server_ciphers on;
	ssl_ciphers             ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-SHA:AES256-SHA;
	ssl_session_cache       shared:SSL:40m;
	ssl_session_timeout     2h;
	ssl_session_tickets     off;

	#redirect the legacy Browser Phone URL to the Webphone module
	rewrite ^/app/browser_phone(?:/(.*))?$ /app/webphone/$1 permanent;

	#React portal and staff Customer management built from app/portal/spa.
	#Keep it on the PBX host so staff routes use the authenticated FusionPBX
	#session. The customer-facing copy remains available on call.mphone.vn.
	location = /p/index.html {
		root /var/www/fusionpbx;
		add_header Cache-Control "no-store";
	}

	location /p/ {
		root /var/www/fusionpbx;
		#client-side routing, any unknown path is answered by the application shell
		try_files $uri $uri/ /p/index.html;
	}

	#Mphone Portal Next staging. This is a versioned local Debian build and
	#does not depend on the Windows SSHFS mount at request time.
	location = /p-next {
		return 301 /p-next/;
	}

	location = /p-next/index.html {
		root /var/www/fusionpbx;
		add_header Cache-Control "no-store";
		add_header X-Mphone-Environment "portal-next" always;
	}

	location ^~ /p-next/assets/ {
		root /var/www/fusionpbx;
		try_files $uri =404;
		add_header Cache-Control "public, max-age=31536000, immutable" always;
		add_header X-Mphone-Environment "portal-next" always;
	}

	location ^~ /p-next/ {
		root /var/www/fusionpbx;
		try_files $uri $uri/ /p-next/index.html;
		add_header X-Mphone-Environment "portal-next" always;
	}

	#redirect websockets to port 8080
	location /websockets/ {
		proxy_pass http://127.0.0.1:8080;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header Host $host;
	}

	#independent Browser Phone integration - SIP over secure WebSocket
	location /browser-phone-ws {
		proxy_pass http://127.0.0.1:5066;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_read_timeout 3600s;
		proxy_send_timeout 3600s;
		proxy_buffering off;
	}

	#redirect letsencrypt to dehydrated
