server {
	listen [::]:80;
	listen 80;
	server_name call.mphone.vn;

	location ^~ /.well-known/acme-challenge/ {
		default_type "text/plain";
		root /var/www/dehydrated;
	}

	location / {
		return 301 https://call.mphone.vn$request_uri;
	}
}

server {
	listen [::]:443 ssl;
	listen 443 ssl;
	server_name call.mphone.vn;

	ssl_certificate /etc/letsencrypt/live/call.mphone.vn/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/call.mphone.vn/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_session_cache shared:MPHONE_CALL_SSL:10m;
	ssl_session_timeout 1h;
	ssl_session_tickets off;

	client_max_body_size 10M;

	location = / {
		return 302 /p/;
	}

	location = /p/index.html {
		root /var/www/fusionpbx;
		add_header Cache-Control "no-store";
	}

	location /p/ {
		root /var/www/fusionpbx;
		try_files $uri $uri/ /p/index.html;
	}

	location = /p-next {
		return 301 /p-next/;
	}

	location = /p-next/index.html {
		root /var/www/fusionpbx;
		add_header Cache-Control "no-store";
		add_header X-Mphone-Environment "portal-next" always;
	}

	location ^~ /p-next/assets/ {
		root /var/www/fusionpbx;
		try_files $uri =404;
		add_header Cache-Control "public, max-age=31536000, immutable" always;
		add_header X-Mphone-Environment "portal-next" always;
	}

	location ^~ /p-next/ {
		root /var/www/fusionpbx;
		try_files $uri $uri/ /p-next/index.html;
		add_header X-Mphone-Environment "portal-next" always;
	}

	# Authenticated hot-reload preview served by Vite on the Windows host.
	# The UI source/runtime stays on Windows while API calls remain same-origin
	# on Debian, so the normal FusionPBX session and permissions are reused.
	location ^~ /mphone-ui-dev/ {
		auth_request /app/portal/service/session.php;
		proxy_pass http://100.74.212.13:4324;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto https;
		proxy_buffering off;
		proxy_read_timeout 3600s;
		add_header Cache-Control "no-store" always;
		add_header X-Mphone-Environment "windows-live-dev" always;
	}

	location ~ ^/app/portal/service/[a-z_]+\.php$ {
		root /var/www/fusionpbx;
		try_files $uri =404;
		fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
		fastcgi_index index.php;
		include fastcgi_params;
		fastcgi_param SCRIPT_FILENAME /var/www/fusionpbx$fastcgi_script_name;
		fastcgi_read_timeout 60s;
	}

	location /themes/ {
		root /var/www/fusionpbx;
		try_files $uri =404;
	}

	location /websockets/ {
		proxy_pass http://127.0.0.1:8080;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header Host $host;
		proxy_read_timeout 3600s;
	}

	location /functions/ {
		proxy_pass http://127.0.0.1:8000;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto https;
		proxy_read_timeout 60s;
	}

	location / {
		return 404;
	}
}
