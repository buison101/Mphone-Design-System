## Mantis 4.2.0 original environment, with every vendor secret removed.
## Only non-secret values are kept. Nothing here is a credential.

VITE_APP_VERSION = v4.2.0
GENERATE_SOURCEMAP = false

## Public URL
PUBLIC_URL =
VITE_APP_BASE_NAME = /

## Backend API URL — CodedThemes' public mock API, the original data source.
## Requires internet. When it is unreachable the offline cache in
## src/utils/offline-cache.js answers instead.
VITE_APP_API_URL=https://mock-data-api-nextjs.vercel.app/

## The vendor shipped live keys for the services below. They were removed and
## are intentionally left blank: the pages that use them degrade, they do not
## crash. Supply your own values only in a local .env that is never committed.
VITE_APP_GOOGLE_MAPS_API_KEY=
VITE_APP_FIREBASE_API_KEY=
VITE_APP_FIREBASE_AUTH_DOMAIN=
VITE_APP_FIREBASE_PROJECT_ID=
VITE_APP_FIREBASE_STORAGE_BUCKET=
VITE_APP_FIREBASE_MESSAGING_SENDER_ID=
VITE_APP_FIREBASE_APP_ID=
VITE_APP_FIREBASE_MEASUREMENT_ID=
VITE_APP_AWS_POOL_ID=
VITE_APP_AWS_APP_CLIENT_ID=
VITE_APP_AUTH0_CLIENT_ID=
VITE_APP_AUTH0_DOMAIN=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

## Analytics / telemetry identifiers removed on purpose. Do not restore.
VITE_APP_PUBLIC_CLARITY_ID=
VITE_APP_PUBLIC_NOTIFY_ID=
VITE_APP_PUBLIC_ANALYTICS_ID=
